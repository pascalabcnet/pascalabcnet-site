---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { articleCategories } from '../../../lib/article-categories';
import 'katex/dist/katex.min.css';

export async function getStaticPaths() {
  const items = await getCollection('articlesEn', ({ data }) => !data.draft);
  return items.map(item => ({ params: { slug: item.id }, props: { item } }));
}

const { item } = Astro.props;
const { Content } = await render(item);
const format = new Intl.DateTimeFormat('en-GB', { day: 'numeric', month: 'long', year: 'numeric' });
const category = articleCategories.find(category => category.labelEn === item.data.category);
const articleUrl = new URL(Astro.url.pathname, Astro.site).href;
const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: item.data.displayTitle ?? item.data.title,
  description: item.data.description,
  inLanguage: 'en',
  articleSection: item.data.category,
  keywords: item.data.tags,
  ...(item.data.date ? { datePublished: item.data.date.toISOString() } : {}),
  publisher: { '@type': 'Organization', name: 'PascalABC.NET', url: 'https://pascalabc.net/' },
  mainEntityOfPage: articleUrl,
};
const breadcrumbs = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Articles', item: new URL('/en/articles/', Astro.site).href },
    ...(category ? [{ '@type': 'ListItem', position: 2, name: category.labelEn, item: new URL(`/en/articles/category/${category.slug}/`, Astro.site).href }] : []),
    { '@type': 'ListItem', position: category ? 3 : 2, name: item.data.displayTitle ?? item.data.title, item: articleUrl },
  ],
};
---
<BaseLayout locale="en" title={item.data.title} description={item.data.description}>
  <article class="article-page page-shell">
    <p class="article-back"><a href="/en/articles/">← All articles</a></p>
    <h1>{item.data.displayTitle ?? item.data.title}</h1>
    <div class="article-meta article-page-meta">
      {item.data.date && <time datetime={item.data.date.toISOString()}>{format.format(item.data.date)}</time>}
      {category ? <a href={`/en/articles/category/${category.slug}/`}>{item.data.category}</a> : <span>{item.data.category}</span>}
    </div>
    <div class="prose"><Content /></div>
  </article>
  <script is:inline type="application/ld+json" set:html={JSON.stringify([articleSchema, breadcrumbs]).replace(/</g, '\u003c')}></script>
</BaseLayout>

<style is:global>
  .article-page .katex-display { overflow-x: auto; overflow-y: hidden; padding: 4px 0; }
</style>
