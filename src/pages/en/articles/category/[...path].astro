---
import { getCollection } from 'astro:content';
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import ArticleArchive from '../../../../components/ArticleArchive.astro';
import { publishedCategories } from '../../../../lib/article-categories';

export async function getStaticPaths() {
  const pageSize = 8;
  const allItems = (await getCollection('articlesEn', ({ data }) => !data.draft))
    .sort((a, b) => (b.data.date?.valueOf() ?? 0) - (a.data.date?.valueOf() ?? 0));
  const categories = publishedCategories(allItems, 'en');
  return categories.flatMap(category => {
    const items = allItems.filter(item => item.data.category === category.label);
    const totalPages = Math.ceil(items.length / pageSize);
    return Array.from({ length: totalPages }, (_, index) => ({
      params: { path: index === 0 ? category.slug : `${category.slug}/page/${index + 1}` },
      props: { category, categories, items: items.slice(index * pageSize, (index + 1) * pageSize), currentPage: index + 1, totalPages },
    }));
  });
}

const { category, categories, items, currentPage, totalPages } = Astro.props;
const descriptions: Record<string, string> = {
  algorithms: "Learn algorithms and data structures in PascalABC.NET with complete examples, including Dijkstra's shortest-path algorithm.",
  dotnet: 'Use .NET libraries in PascalABC.NET: practical tutorials on PriorityQueue, priority-based processing, and modern .NET APIs.',
};
---
<BaseLayout locale="en" title={`${category.label} in PascalABC.NET${currentPage > 1 ? ` — Page ${currentPage}` : ''}`} description={descriptions[category.slug] ?? `PascalABC.NET tutorials in the ${category.label} category.`}>
  <ArticleArchive locale="en" items={items} categories={categories} selectedCategory={category.slug} pageBase={`/en/articles/category/${category.slug}/`} currentPage={currentPage} totalPages={totalPages} />
</BaseLayout>
