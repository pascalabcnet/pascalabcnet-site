---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProgramTabs from '../../components/ProgramTabs.astro';
import NewsSidebar from '../../components/NewsSidebar.astro';
import Card from '../../components/Card.astro';
import ExternalLink from '../../components/ExternalLink.astro';
import Icon from '../../components/Icon.astro';
import { externalLinks } from '../../data/external-links';
---
<BaseLayout locale="en" title="PascalABC.NET" description="A modern Pascal programming language for .NET.">
  <div class="main-grid"><section class="content" aria-label="About PascalABC.NET">
    <div class="description"><p><span class="brand">PascalABC.NET</span> is a new-generation programming language for the .NET platform, designed for teaching and learning modern programming, scientific research, and application development. It combines a broad range of modern language features — type inference, tuples, slices, generics, lambda expressions, and interfaces — with simple, clear syntax that makes it possible to write concise and efficient code.</p></div>
    <div class="description-cta"><a class="btn-secondary" href="/en/about/">About PascalABC.NET →</a><a class="btn-primary" href="/en/downloads/"><Icon name="download" /> Download PascalABC.NET ...</a><ExternalLink class="btn-secondary ml-cta-top" href={externalLinks.mlPascalABC} label="ML PascalABC.NET">ML PascalABC.NET →</ExternalLink></div>
    <ProgramTabs locale="en" />
    <ExternalLink class="btn-secondary ml-cta-after-tabs" href={externalLinks.mlPascalABC} label="ML PascalABC.NET">ML PascalABC.NET →</ExternalLink>
    <section class="cards cards-four" aria-label="Main sections">
      <Card title="Download" description="The latest versions for Windows and .NET 10." href="/en/downloads/" linkLabel="Download →" icon="download" />
      <Card title="Documentation" description="A concise introduction to PascalABC.NET." href={externalLinks.yMinutesEnglish} external linkLabel="Open →" icon="documentation" />
      <Card title="VS Code" description="The PascalABC.NET extension for Visual Studio Code." href="/en/vscode/" linkLabel="Open →" icon="vscode" />
      <Card title="Community" href={null} icon="community"><ul class="link-list"><li><ExternalLink href={externalLinks.telegramChannel} label="Telegram channel" /></li><li><ExternalLink href={externalLinks.telegramGroup} label="Telegram group" /></li><li><a href={externalLinks.github} target="_blank" rel="noopener noreferrer">GitHub</a></li></ul></Card>
    </section>
  </section><NewsSidebar locale="en" limit={3} excludeOlympiads /></div>
</BaseLayout>
