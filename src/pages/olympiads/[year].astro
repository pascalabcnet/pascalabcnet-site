---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import OlympiadArchiveCard from '../../components/OlympiadArchiveCard.astro';

export async function getStaticPaths() {
  const items = await getCollection('olympiads', ({ data }) => !data.draft);
  return items.map(item => ({ params: { year: item.id }, props: { item } }));
}

const { item } = Astro.props;
---

<BaseLayout title={item.data.title} description={item.data.description}>
  <article class="olympiad-page olympiad-year-page">
    <p class="olympiad-back"><a href="/olympiads">← Все олимпиады</a></p>
    <h1>{item.data.title}</h1>
    <OlympiadArchiveCard item={item} />
  </article>
</BaseLayout>
