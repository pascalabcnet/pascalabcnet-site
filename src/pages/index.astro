---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProgramTabs from '../components/ProgramTabs.astro';
import NewsSidebar from '../components/NewsSidebar.astro';
import Card from '../components/Card.astro';
import ExternalLink from '../components/ExternalLink.astro';
import Icon from '../components/Icon.astro';
import { externalLinks } from '../data/external-links';
---
<BaseLayout>
  <div class="main-grid"><section class="content" aria-label="О PascalABC.NET">
    <div class="description"><p><span class="brand">PascalABC.NET</span> — язык программирования нового поколения на платформе .NET для обучения современному программированию, научных исследований и создания прикладных программ. Он сочетает <span class="intro-desktop-copy">широкий набор современных языковых конструкций — автоматический вывод типов, диапазоны, кортежи, срезы, обобщения, лямбда-выражения, интерфейсы — с простым и понятным</span><span class="intro-mobile-copy">вывод типов, кортежи, срезы, обобщения, лямбда-выражения и интерфейсы с простым</span> синтаксисом, позволяющим писать краткий и эффективный код.</p></div>
    <div class="description-cta"><a class="btn-secondary" href="/about">О PascalABC.NET →</a><a class="btn-primary" href="/ssyilki-dlya-skachivaniya"><Icon name="download" /> Скачать PascalABC.NET ...</a><ExternalLink class="btn-secondary ml-cta-top" href={externalLinks.mlPascalABC} label="ML PascalABC.NET">ML PascalABC.NET →</ExternalLink></div>
    <ProgramTabs />
    <ExternalLink class="btn-secondary ml-cta-after-tabs" href={externalLinks.mlPascalABC} label="ML PascalABC.NET">ML PascalABC.NET →</ExternalLink>
    <section class="cards" aria-label="Основные разделы">
      <Card title="Скачать" description="Последняя версия для Windows, Linux, macOS." href="/ssyilki-dlya-skachivaniya" linkLabel="Скачать →" icon="download" />
      <Card title="Документация" description="Справочник по языку и стандартным модулям." href={externalLinks.help} external linkLabel="Перейти →" icon="documentation" />
      <Card title="VS Code" description="Расширение для Visual Studio Code." href="/vscode" linkLabel="Перейти →" icon="vscode" />
      <Card title="Курсы на Stepik" description="Интерактивные курсы для начинающих." href="/stepik" linkLabel="Перейти →" icon="stepik" />
      <Card title="Примеры и задачи" description="Примеры программ и олимпиадные задачи." href={externalLinks.olympiadProblems} external linkLabel="Смотреть →" icon="examples" />
      <Card title="Сообщество" href={null} icon="community"><ul class="link-list"><li><ExternalLink href={externalLinks.telegramChannel} label="Telegram-канал" /></li><li><ExternalLink href={externalLinks.maxChannel} label="MAX-канал" /></li><li><a href={externalLinks.github} target="_blank" rel="noopener noreferrer">GitHub</a></li></ul></Card>
    </section>
  </section><NewsSidebar /></div>
</BaseLayout>
<script is:inline>
  (() => {
    if (location.pathname !== '/') return;
    let saved = null;
    try { saved = localStorage.getItem('pabc_locale'); } catch {}
    if (saved === 'en') { location.replace('/en/'); return; }
    if (saved === 'ru') return;
    const language = (navigator.languages?.[0] || navigator.language || '').toLowerCase();
    if (!language.startsWith('ru')) location.replace('/en/');
  })();
</script>
