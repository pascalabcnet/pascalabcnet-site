---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import ExamplesLayout from '../../layouts/ExamplesLayout.astro';

export async function getStaticPaths() {
  const entries = (await getCollection('examples', ({ data }) => !data.draft)).sort((a, b) => a.data.order - b.data.order);
  return entries.map((entry, index) => ({
    params: { slug: entry.data.slug ?? entry.id },
    props: {
      entry,
      entries,
      previous: entries[index - 1],
      next: entries[index + 1]
    }
  }));
}

interface Props {
  entry: CollectionEntry<'examples'>;
  entries: CollectionEntry<'examples'>[];
  previous?: CollectionEntry<'examples'>;
  next?: CollectionEntry<'examples'>;
}

const { entry, entries, previous, next } = Astro.props;
const { Content } = await render(entry);
const currentSlug = entry.data.slug ?? entry.id;
---

<ExamplesLayout title={entry.data.title} description={entry.data.description} entries={entries} currentSlug={currentSlug} previous={previous} next={next}>
  <Content />
</ExamplesLayout>
