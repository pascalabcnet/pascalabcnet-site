---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
export async function getStaticPaths(){const pages=await getCollection('pages',({data})=>!data.draft);return pages.map(page=>({params:{slug:page.data.slug??page.id},props:{page}}));}
const {page}=Astro.props;const {Content}=await render(page);const pageSlug=page.data.slug??page.id;
---
<BaseLayout title={page.data.title} description={page.data.description}><article class:list={['page-shell',{'stepik-page':pageSlug==='stepik','book-catalog-page':pageSlug==='books','book-author-page':pageSlug==='modernprogramming'||pageSlug==='rubantsevbooks','developers-page':pageSlug==='developers','release-page':pageSlug.startsWith('whats-new/'),'whats-new-index':pageSlug==='whats-new','release-archive-page':pageSlug==='whats-new/archive','vscode-page':pageSlug==='vscode','download-page':pageSlug==='ssyilki-dlya-skachivaniya','publications-page':pageSlug==='publications'||pageSlug==='publications/archive'}]}><h1>{page.data.title}</h1><div class="prose"><Content /></div></article></BaseLayout>
