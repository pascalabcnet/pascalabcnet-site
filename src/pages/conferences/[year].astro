---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ConferenceArchiveCard from '../../components/ConferenceArchiveCard.astro';

export async function getStaticPaths() {
  const items = await getCollection('conferences', ({ data }) => !data.draft);
  return items.map(item => ({ params: { year: item.id }, props: { item } }));
}

const { item } = Astro.props;
---

<BaseLayout title={item.data.title} description={item.data.description}>
  <article class="conference-page conference-year-page">
    <p class="conference-back"><a href="/conferences">← Все конференции</a></p>
    <h1>{item.data.year}</h1>
    <ConferenceArchiveCard item={item} />
  </article>
</BaseLayout>
