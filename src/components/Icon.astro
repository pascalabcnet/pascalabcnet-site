  {name === 'max' && <path d="M15.6307,40.4647c8.0824,7.1933,27.8593-1.1656,27.782-15.8504-.053-10.067-8.3059-20.0247-18.5404-20.1135-9.5372-.0827-19.6469,5.9619-20.2285,17.7674-.1732,3.5151,0,8.8586,1.2303,11.7305,2.3345,6.6998.1133,8.4765,2.8039,9.3271,2.4112.6009,4.7288-.3528,6.9526-2.8611Z"/>}
