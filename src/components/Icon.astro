  {name === 'vscode' && <><polyline points="16 18 22 12 16 6"/><polyline points="8 6 2 12 8 18"/></>}
  {name === 'stepik' && <><path d="M12 6v7m0 0-3-3m3 3 3-3"/><path d="M4 4v4a4 4 0 0 0 4 4h8a4 4 0 0 0 4-4V4"/><path d="M4 20h16"/></>}
