---
import { getCollection } from 'astro:content';
import { externalLinks } from '../data/external-links';
import ExternalLink from './ExternalLink.astro';
import Icon from './Icon.astro';
interface Props { locale?: 'ru'|'en'; limit?: number; excludeOlympiads?: boolean }
const {locale='ru',limit=4,excludeOlympiads=false}=Astro.props;
const allNews=locale==='en'?await getCollection('newsEn',({data})=>!data.draft):await getCollection('news',({data})=>!data.draft);
const news=allNews.filter(item=>!excludeOlympiads||!item.id.toLowerCase().includes('olympiad')).sort((a,b)=>b.data.date.valueOf()-a.data.date.valueOf()).slice(0,limit);
const dateFormat=new Intl.DateTimeFormat(locale==='en'?'en-GB':'ru-RU',{day:'2-digit',month:'2-digit',year:'2-digit'});
const en=locale==='en';
---
<aside class="news-sidebar" aria-label={en?'News and current information':'Новости и актуальная информация'}>
  <h2>{en?'News':'Новости'}</h2>
  {news.map(item=><article class="news-item"><time datetime={item.data.date.toISOString()}>{dateFormat.format(item.data.date)}</time><a href={item.data.externalUrl??`${en?'/en':''}/news/${item.id}`} target={item.data.externalUrl?'_blank':undefined} rel={item.data.externalUrl?'noopener noreferrer':undefined}>{item.data.title}</a></article>)}
  {!en&&<div class="news-archive"><a href="/news">Архив новостей →</a></div>}
  <div class="sidebar-footer">
    <section class="product-status" aria-labelledby="product-status-title">
      <span class="product-status-label">{en?'Current version':'Актуальная версия'}</span>
      <strong id="product-status-title" class="product-status-version">PascalABC.NET 4.0</strong>
      <p class="product-status-lead">{en?'A new generation of PascalABC.NET':'Новое поколение PascalABC.NET'}</p>
      <ul>
        <li><strong>Multitarget</strong>: .NET Framework 4.7.2 + .NET 10</li>
        <li>VS Code + IntelliSense</li>
        <li><ExternalLink href={externalLinks.mlPascalABC} label="ML PascalABC.NET" /></li>
      </ul>
      <a class="product-status-link" href={en?'/en/whats-new/pascalabcnet-4.0/':'/whats-new/pascalabcnet-4.0'}>{en?"What's new in 4.0 →":'Что нового в 4.0 →'}</a>
    </section>
    <ExternalLink href={externalLinks.telegramChannel} label={en?'Telegram channel':'Telegram-канал'} class="sidebar-link"><Icon name="telegram" class="sidebar-icon" />{en?'Telegram channel':'Telegram-канал'}</ExternalLink>
    {!en&&<ExternalLink href={externalLinks.maxChannel} label="MAX-канал" class="sidebar-link"><Icon name="max" class="sidebar-icon" />MAX-канал</ExternalLink>}
  </div>
</aside>
