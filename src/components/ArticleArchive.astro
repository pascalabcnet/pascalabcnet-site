---
const { items, draftItems = [], categories = [], selectedCategory = '', locale = 'ru', currentPage = 1, totalPages = 1 } = Astro.props;
const en = locale === 'en';
const archiveBase = en ? '/en/articles/' : '/articles/';
const { pageBase = archiveBase } = Astro.props;
const format = new Intl.DateTimeFormat(en ? 'en-GB' : 'ru-RU', { day: 'numeric', month: 'long', year: 'numeric' });
const pageHref = (page: number) => page === 1 ? pageBase : `${pageBase}page/${page}/`;
---
<section class="articles-page">
  <header class="articles-header">
    <h1>{en ? 'Articles' : 'Статьи'}</h1>
    <nav class="article-filters" aria-label={en ? 'Article categories' : 'Рубрики статей'}>
      <a href={archiveBase} aria-current={!selectedCategory ? 'page' : undefined}>{en ? 'All' : 'Все'}</a>
      {categories.map((category: { label: string; slug: string }) =>
        <a href={`${archiveBase}category/${category.slug}/`} aria-current={selectedCategory === category.slug ? 'page' : undefined}>{category.label}</a>
      )}
    </nav>
  </header>

  {items.length > 0
    ? <ol class="article-list">
        {items.map((item: any) => <li>
          <article>
            <h2><a href={`${archiveBase}${item.id}/`}>{item.data.displayTitle ?? item.data.title}</a></h2>
            <div class="article-meta">
              {item.data.date
                ? <time datetime={item.data.date.toISOString()}>{format.format(item.data.date)}</time>
                : <span class="article-date-missing">{en ? 'Publication date to be confirmed' : 'Дата публикации уточняется'}</span>}
              <span>{item.data.category}</span>
            </div>
            <p>{item.data.description}</p>
          </article>
        </li>)}
      </ol>
    : draftItems.length === 0 && <p class="article-empty">{en ? 'No articles have been published yet.' : 'Опубликованных статей пока нет.'}</p>}

  {draftItems.length > 0 && <section class="article-drafts" aria-labelledby="articles-in-preparation">
    <h2 id="articles-in-preparation">{en ? 'Coming soon' : 'Готовятся к публикации'}</h2>
    <ul>
      {draftItems.map((item: any) => <li>
        <strong>{item.data.displayTitle ?? item.data.title}</strong>
        <span>{item.data.category}</span>
      </li>)}
    </ul>
  </section>}

  {totalPages > 1 && <nav class="news-pagination" aria-label={en ? 'Article archive pages' : 'Страницы архива статей'}>
    <div class="news-pagination-side news-pagination-side-left">
      {currentPage > 1 && <a class="news-pagination-direction" href={pageHref(currentPage - 1)} rel="prev">{en ? '← Newer' : '← Более новые'}</a>}
    </div>
    <div class="news-pagination-pages">
      {Array.from({ length: totalPages }, (_, index) => index + 1).map(page => page === currentPage
        ? <span aria-current="page">{page}</span>
        : <a href={pageHref(page)} aria-label={en ? `Page ${page}` : `Страница ${page}`}>{page}</a>)}
    </div>
    <div class="news-pagination-side news-pagination-side-right">
      {currentPage < totalPages && <a class="news-pagination-direction" href={pageHref(currentPage + 1)} rel="next">{en ? 'Older →' : 'Более ранние →'}</a>}
    </div>
  </nav>}
</section>

<style>
  .article-filters { display: flex; flex-wrap: wrap; gap: 6px; margin-top: 12px; }
  .article-filters a { padding: 6px 12px; border-radius: 6px; color: #52616c; font-size: 14px; text-decoration: none; }
  .article-filters a:hover { background: #edf2f5; }
  .article-filters a[aria-current="page"] { background: #e8f1f7; color: #28577e; font-weight: 600; }
  .article-filters a:focus-visible { outline: 2px solid #28577e; outline-offset: 2px; }
</style>
