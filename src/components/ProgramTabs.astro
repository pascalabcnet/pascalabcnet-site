---
import { highlightPascalABC } from '../syntaxes/pascalabc-highlighting.mjs';
import start from '../examples/start.pas?raw'; import loops from '../examples/loops.pas?raw'; import lists from '../examples/lists.pas?raw'; import linq from '../examples/linq.pas?raw'; import slices from '../examples/slices.pas?raw'; import regex from '../examples/regex.pas?raw';
const examples=[{label:'Основы',code:start},{label:'Циклы',code:loops},{label:'Списки',code:lists},{label:'LINQ',code:linq},{label:'Срезы',code:slices},{label:'Regex',code:regex}];
const highlighted=await Promise.all(examples.map(({code})=>highlightPascalABC(code)));
---
<section class="tabs-section" aria-label="Примеры программ PascalABC.NET"><div class="tabs-nav" role="tablist" aria-label="Выберите пример программы">{examples.map((item,i)=><button id={`tab-${i}`} class:list={['tab-btn',i===0&&'active']} type="button" role="tab" aria-selected={i===0?'true':'false'} aria-controls={`panel-${i}`} tabindex={i===0?0:-1}>{item.label}</button>)}</div>{highlighted.map((html,i)=><div id={`panel-${i}`} class:list={['tab-content',i===0&&'active']} role="tabpanel" aria-labelledby={`tab-${i}`} hidden={i!==0}><Fragment set:html={html}/></div>)}</section>
<script>
const setupTabs=()=>document.querySelectorAll<HTMLElement>('.tabs-section').forEach(section=>{if(section.dataset.ready)return;section.dataset.ready='true';const tabs=[...section.querySelectorAll<HTMLButtonElement>('[role="tab"]')];const panels=[...section.querySelectorAll<HTMLElement>('[role="tabpanel"]')];const activate=(index:number)=>{tabs.forEach((tab,i)=>{const active=i===index;tab.classList.toggle('active',active);tab.setAttribute('aria-selected',String(active));tab.tabIndex=active?0:-1;panels[i].hidden=!active;panels[i].classList.toggle('active',active)});tabs[index].focus()};tabs.forEach((tab,index)=>{tab.addEventListener('click',()=>activate(index));tab.addEventListener('keydown',e=>{let next=index;if(e.key==='ArrowRight')next=(index+1)%tabs.length;else if(e.key==='ArrowLeft')next=(index-1+tabs.length)%tabs.length;else if(e.key==='Home')next=0;else if(e.key==='End')next=tabs.length-1;else return;e.preventDefault();activate(next)})})});setupTabs();document.addEventListener('astro:page-load',setupTabs);
</script>
