DirectoryIndex index.html

# Do not expose directory listings. Files in /downloads/ remain accessible
# through their complete URLs, but /downloads/ itself is not a web page.
Options -Indexes

# Permanent redirects from valuable legacy Joomla URLs.
RewriteEngine On
RewriteRule ^wiki(?:/|$) - [G,L,NC]
RewriteRule ^modules/pgs/ - [G,L]
RewriteRule ^downloads/?$ /ssyilki-dlya-skachivaniya/ [R=301,L,QSD]
RewriteRule ^stepikcourse/?$ /stepik/ [R=301,L,QSD]
RewriteRule ^o-yazike-paskal/?$ / [R=301,L,QSD]
RewriteRule ^component/search/?$ / [R=301,L,NC,QSD]
RewriteRule ^2-uncategorised/91-prezentations/?$ / [R=301,L,NC,QSD]
RewriteRule ^13-stranitsy-na-sajte-en/?$ / [R=301,L,NC,QSD]
RewriteRule ^12-/?$ /examples/ [R=301,L,NC,QSD]
RewriteRule ^stepikcourse/2-uncategorised/125-olymp-pabc/?$ / [R=301,L,NC,QSD]
RewriteRule ^ru/o-yazike-paskal/?$ / [R=301,L,NC,QSD]
RewriteRule ^en/modernprogramming/?$ /modernprogramming/ [R=301,L,NC,QSD]
RewriteRule ^en/razrabotchiki-pascalabc-net/?$ /en/developers/ [R=301,L,NC,QSD]
RewriteRule ^en/stati-po-pascalabc-net/?$ /articles/ [R=301,L,NC,QSD]
RewriteRule ^en/dokladi/?$ /publications/ [R=301,L,NC,QSD]
RewriteRule ^en/screenshots/?$ /screenshots/ [R=301,L,NC,QSD]
RewriteRule ^en/rubantsevbooks/2-uncategorised/91-prezentations/?$ /rubantsevbooks/ [R=301,L,NC,QSD]
RewriteRule ^en/dokladi/12-stranitsy-na-sajte/13-programmy-i-algoritmy-dlya-nachinayushchikh/?$ /examples/ [R=301,L,NC,QSD]
RewriteRule ^en/12-stranitsy-na-sajte/35-testy-proizvoditelnosti/?$ /articles/measuring-performance/ [R=301,L,NC,QSD]
RewriteRule ^en/litsenzionnoe-soglashenie/12-stranitsy-na-sajte/35-testy-proizvoditelnosti/?$ /articles/measuring-performance/ [R=301,L,NC,QSD]
RewriteRule ^m/stati-po-pascalabc-net/10-obuchenie-programmirovaniyu/28-meryaem-proizvoditelnost/?$ /articles/measuring-performance/ [R=301,L,NC,QSD]
RewriteRule ^stati-po-pascalabc-net/osobennosti-yazika/23-prostejshie-novye-vozmozhnosti/?$ /examples/ [R=301,L,NC,QSD]
RewriteRule ^litsenzionnoe-soglashenie/12-stranitsy-na-sajte/33-programmy-i-algoritmy-i-dlya-studentov/?$ /examples/ [R=301,L,NC,QSD]
RewriteRule ^rubantsevbooks/2-uncategorised/91-prezentations/?$ / [R=301,L,NC,QSD]
RewriteRule ^9-kratkie-novosti/?$ / [R=301,L,NC,QSD]
RewriteRule ^9-kratkie-novosti/103-pabc-ege/?$ / [R=301,L,NC,QSD]
RewriteRule ^9-kratkie-novosti/89-polnaya-kniga-osipova/?$ /modernprogramming/ [R=301,L,NC,QSD]
RewriteRule ^9-kratkie-novosti/(?:51-pascalabc-net-3-0|94-versiya-3-7|100-3-8)/?$ /whats-new/pascalabcnet-4.0/ [R=301,L,NC,QSD]
RewriteRule ^chto-novogo/?$ /whats-new/ [R=301,L]
RewriteRule ^pascalabc-net-eto/?$ / [R=301,L]
RewriteRule ^en/pascalabc-net-is/?$ /en/ [R=301,L]
RewriteRule ^en/litsenzionnoe-soglashenie/?$ /en/license/ [R=301,L]
RewriteRule ^2-uncategorised/125-olymp-pabc/?$ /olympiads/ [R=301,L]
RewriteRule ^2-uncategorised/127-confpabc2025/?$ /conferences/2025/ [R=301,L]
RewriteRule ^litsenzionnoe-soglashenie/?$ /license/ [R=301,L]
RewriteRule ^razrabotchiki-pascalabc-net/?$ /developers/ [R=301,L]
RewriteRule ^primeri-programm/?$ /examples/ [R=301,L]
RewriteRule ^olymp-pabc/?$ /olympiads/ [R=301,L]
RewriteRule ^confpabc-(2025|2023|2021)/?$ /conferences/$1/ [R=301,L]
RewriteRule ^confpabc2020/?$ /conferences/2020/ [R=301,L]
RewriteRule ^en/(?:download|ssyilki-dlya-skachivaniya)/?$ /en/downloads/ [R=301,L,NC]

# Legacy Joomla article URLs.
RewriteRule ^stati-po-pascalabc-net/osobennosti-yazika/25-vsjo-vnutri/?$ /articles/all-inside/ [R=301,L]
RewriteRule ^stati-po-pascalabc-net/osobennosti-yazika/17-vse-tipy-klassy/?$ /articles/all-types-are-classes/ [R=301,L]
RewriteRule ^stati-po-pascalabc-net/(?:10-)?obuchenie-programmirovaniyu/24-dinamicheskij-ili-staticheskij/?$ /articles/dynamic-or-static/ [R=301,L]
RewriteRule ^stati-po-pascalabc-net/osobennosti-yazika/26-zarisovki-v-funktsionalnom-stile/?$ /articles/func-style/ [R=301,L]
RewriteRule ^stati-po-pascalabc-net/obuchenie-programmirovaniyu/16-grafika-grafika-grafika-chast-1-vvedenie/?$ /articles/graphics-introduction/ [R=301,L]
RewriteRule ^stati-po-pascalabc-net/20-grafika-klassy-shtampov/?$ /articles/graphics-stamp-classes/ [R=301,L]
RewriteRule ^stati-po-pascalabc-net/(?:10-)?obuchenie-programmirovaniyu/28-meryaem-proizvoditelnost/?$ /articles/measuring-performance/ [R=301,L]
RewriteRule ^stati-po-pascalabc-net/obuchenie-programmirovaniyu/27-regulyaro-vyrazhaemsya/?$ /articles/regular-expressions/ [R=301,L]
